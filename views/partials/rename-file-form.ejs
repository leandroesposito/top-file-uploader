<div class="hidden-form-container">
  <button class="button reveal-form">
    Rename
  </button>
  <form action="/file/<%= file.id %>/rename" method="POST" class="hidden-form hidden rename-file-form">
    <div class="form-row">
      <label for="newName">New name</label>
      <input type="text" name="newName" id="newName" />
    </div>
    <button class="button submit" type="submit">Rename</button>
  </form>
</div>
