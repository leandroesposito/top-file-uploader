<%- include('./partials/upper-body.ejs') %>
<div class="path">
  <div class="path-item">
    <a href="/folder">/</a>
  </div>
  <% path.forEach(pathItem => { %>
   <div class="path-item">
    <a href="/folder/<%- pathItem.id %>">
      <%= pathItem.name %>
    </a>
   </div>
  <% }) %>
</div>
<% if (path.length > 0) { %>
  <form action="/folder/<%= folder.id %>/rename" method="POST">
    <div class="form-row">
      <label for="newName">New name</label>
      <input type="text" name="newName" id="newName">
    </div>
    <button class="button" type="submit">Rename</button>
  </form>
<% } %>
<div class="folder">
  <%- include('./partials/folder-form.ejs') %>
  <%- include('./partials/upload-form.ejs') %>
  <% folder.children.forEach(subfolder => { %>
    <div class="subfolder">
      <a href="/folder/<%- subfolder.id %>">
        <%= subfolder.name %>
      </a>
    </div>
  <% }) %>
  <% folder.files.forEach(file => { %>
    <div class="file">
      <a href="/file/<%- file.id %>">
        <%= file.originalname %>
      </a>
      <a href="/file/<%- file.id %>/delete">
        Delete
      </a>
      <form action="/file/<%= file.id %>/rename" method="POST">
        <div class="form-row">
          <label for="newName">New name</label>
          <input type="text" name="newName" id="newName">
        </div>
        <button class="button" type="submit">Rename</button>
      </form>
    </div>
  <% }) %>
</div>

<%- include('./partials/lower-body.ejs') %>