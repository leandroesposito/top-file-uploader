<%- include('./partials/upper-body.ejs') %>
<%- include('./partials/folder-buttons.ejs') %>
<%- include('./partials/path.ejs') %>
<div class="folder">
  <%- include('./partials/folder-form.ejs') %>
  <%- include('./partials/upload-form.ejs') %>
  <% folder.children.forEach(subfolder => { %>
    <a class="folder-item subfolder" href="/folder/<%- subfolder.id %>">
        /<%= subfolder.name %>
    </a>
  <% }) %>
  <% folder.files.forEach(file => { %>
    <div class="folder-item file">
      <div class="file-data">
        <div class="file-name">
          <%= file.name %>
        </div>
        <div class="file-size">
          <%= `${file.size} ${file.size > 1 ? "bytes" : "byte"}` %>
        </div>
      </div>
      <a class="button" href="/file/<%- file.id %>">
        Download
      </a>
      <%- include('./partials/rename-file-form.ejs', { file }) %>
      <a
        class="button"
        href="/file/<%- file.id %>/delete"
        onclick="return confirm(`Are you sure you want to DELETE this file?`)"
      >
        Delete
      </a>
    </div>
  <% }) %>
</div>
<script>
  document.body.addEventListener("click", (event) => {
    const target = event.target;

    if (target.classList.contains("reveal-form")){
      const hiddenFormContainer = target.closest(".hidden-form-container");
      const hiddenForm = hiddenFormContainer.querySelector(".hidden-form");
      const input = hiddenForm.querySelector("input");
      hiddenForm.classList.toggle("hidden");
      target.classList.toggle("hidden");
      input.focus();

      hiddenForm.addEventListener("focusout", function onFocusOut(e) {
        setTimeout(() => {
          if (!hiddenFormContainer.contains(document.activeElement)){
            hiddenForm.classList.toggle("hidden");
            target.classList.toggle("hidden");
            hiddenForm.removeEventListener("focusout", onFocusOut);
          }
        }, 10)
      });
    }
  });
</script>
<%- include('./partials/lower-body.ejs') %>